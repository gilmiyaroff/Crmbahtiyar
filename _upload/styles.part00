@import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap');
:root{font-family:Manrope,system-ui,sans-serif;color:#1b1b1d;background:#f5f6f3;font-synthesis:none}*{box-sizing:border-box}body{margin:0;min-width:320px}button,input,select,textarea{font:inherit}button{cursor:pointer}.app{--bg:#f5f6f3;--panel:#fff;--panel2:#f1f2ef;--ink:#1b1b1d;--muted:#777b74;--line:#e4e6e0;--accent:#a3e635;--accent-ink:#223008;min-height:100vh;background:var(--bg);color:var(--ink);display:flex}.app.dark{--bg:#111210;--panel:#191a18;--panel2:#222420;--ink:#f2f3ef;--muted:#999e94;--line:#2d302b;--accent:#a3e635;--accent-ink:#172105}.sidebar{width:236px;position:fixed;inset:0 auto 0 0;background:var(--panel);border-right:1px solid var(--line);padding:24px 16px;display:flex;flex-direction:column;z-index:40}.brand{height:52px;display:flex;align-items:center;gap:11px;font-size:19px;font-weight:800;padding:0 8px}.brandmark{width:32px;height:32px;border-radius:10px;display:grid;place-items:center;background:#1c1d1a;color:#b8f15b;font-weight:800}.brandmark.large{width:48px;height:48px;border-radius:15px;font-size:25px}.sidebar nav{display:grid;gap:5px;margin-top:34px}.nav{border:0;background:transparent;color:var(--muted);height:44px;border-radius:12px;padding:0 12px;display:flex;gap:12px;align-items:center;font-weight:600;text-align:left}.nav svg{width:19px}.nav:hover{background:var(--panel2);color:var(--ink)}.nav.active{background:var(--ink);color:var(--panel)}.dark .nav.active{background:var(--accent);color:#1d240d}.user{margin-top:auto;border-top:1px solid var(--line);padding:20px 4px 0;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:10px}.user span:nth-child(2){display:grid}.user strong{font-size:13px}.user small{font-size:11px;color:var(--muted)}.avatar{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;background:#dcefbf;color:#2f4611;font-weight:800;font-size:12px}.logout{border:0;background:none;color:var(--muted);font-size:11px}.main{margin-left:236px;width:calc(100% - 236px);min-height:100vh}.topbar{height:74px;background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:blur(16px);border-bottom:1px solid var(--line);display:flex;align-items:center;padding:0 28px;gap:12px;position:sticky;top:0;z-index:30}.search{width:min(520px,50vw);height:42px;background:var(--panel);border:1px solid var(--line);border-radius:12px;display:flex;align-items:center;gap:9px;padding:0 13px}.search svg{width:18px;color:var(--muted)}.search input{border:0;outline:0;background:transparent;width:100%;color:var(--ink);font-size:13px}.icon{width:38px;height:38px;border:0;background:transparent;color:var(--muted);border-radius:10px;display:grid;place-items:center}.icon:hover{background:var(--panel2);color:var(--ink)}.icon svg{width:18px}.topbar>.icon:not(.menu){margin-left:auto}.top-avatar{display:none}.menu,.mobile-close{display:none}.content{padding:30px;max-width:1800px;margin:auto}.page-head{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:26px}.page-head h1{font-size:30px;line-height:1.15;margin:4px 0 0;letter-spacing:-.035em}.page-head p{color:var(--muted);margin:8px 0 0;font-size:14px}.eyebrow{text-transform:uppercase;letter-spacing:.12em;font-size:10px;font-weight:800;color:var(--muted)}.head-actions{display:flex;gap:8px}.button{border:0;background:var(--ink);color:var(--panel);height:42px;padding:0 16px;border-radius:11px;font-weight:700;font-size:13px;display:inline-flex;align-items:center;justify-content:center;gap:8px}.dark .button{background:var(--accent);color:#172105}.button svg{width:16px}.button.ghost{background:var(--panel);color:var(--ink);border:1px solid var(--line)}.button.secondary{background:var(--panel2);color:var(--ink)}.button.tiny{height:32px;padding:0 10px}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:18px}.metric{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:19px;display:flex;align-items:center;gap:14px}.metric>span{width:42px;height:42px;border-radius:12px;display:grid;place-items:center;background:var(--panel2)}.metric svg{width:19px}.metric div{display:grid;gap:2px}.metric small{color:var(--muted);font-size:12px}.metric strong{font-size:24px;letter-spacing:-.03em}.metric.danger>span{color:#e34242;background:#ef44441a}.panel{background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:22px}.panel-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:22px}.panel h2{font-size:18px;margin:4px 0;letter-spacing:-.02em}.dashboard-grid{display:grid;grid-template-columns:1.5fr 1fr;gap:18px}.bar-list{display:grid;gap:15px}.bar-label{display:flex;justify-content:space-between;font-size:12px;margin-bottom:7px}.bar-track{height:7px;background:var(--panel2);border-radius:10px;overflow:hidden}.bar-track i{height:100%;display:block;border-radius:10px}.focus-row{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:12px;padding:13px 0;border-bottom:1px solid var(--line)}.focus-row:last-child{border:0}.focus-row div{display:grid}.focus-row strong{font-size:13px}.focus-row small{color:var(--muted);font-size:11px}.focus-row time{font-size:12px}.task-dot{width:8px;height:8px;border-radius:50%;background:var(--accent)}.task-dot.late{background:#ef4444}.deals-toolbar{display:flex;justify-content:space-between;align-items:center;gap:16px;margin-bottom:15px}.pipeline-tabs,.task-tabs{display:flex;gap:4px;background:var(--panel);border:1px solid var(--line);padding:4px;border-radius:13px;width:max-content}.pipeline-tabs button,.task-tabs button{border:0;background:transparent;color:var(--muted);padding:8px 12px;border-radius:9px;font-weight:600;font-size:12px}.pipeline-tabs button.active,.task-tabs button.active{background:var(--ink);color:var(--panel)}.pipeline-tabs span{margin-left:8px;opacity:.6}.filter{display:flex;align-items:center;gap:6px;background:var(--panel);border:1px solid var(--line);border-radius:11px;padding:0 10px;height:40px}.filter svg{width:16px}.filter select{border:0;background:transparent;color:var(--ink);outline:0;font-size:12px}.kanban{display:flex;gap:12px;overflow-x:auto;padding-bottom:18px;align-items:flex-start}.column{width:284px;min-width:284px;background:var(--panel2);border:1px solid var(--line);border-radius:15px;padding:10px}.column-head{display:flex;justify-content:space-between;align-items:center;padding:5px 4px 12px}.column-head>div{display:flex;align-items:center;gap:7px}.column-head i,.settings-list i,.stage-settings i{width:8px;height:8px;border-radius:50%;display:block}.column-head strong{font-size:12px}.column-head span{font-size:10px;background:var(--panel);border:1px solid var(--line);padding:2px 5px;border-radius:6px}.column-head small{font-size:10px;color:var(--muted)}.cards{display:grid;gap:8px}.deal-card{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:13px;cursor:grab;box-shadow:0 1px 1px #00000008;position:relative}.deal-card:before{content:"";position:absolute;left:0;top:13px;bottom:13px;width:3px;border-radius:3px;background:#b7bbb2}.deal-card.priority-high:before{background:#f59e0b}.deal-card.priority-urgent:before{background:#ef4444}.deal-card:hover{transform:translateY(-1px);box-shadow:0 6px 20px #0000000b}.deal-top{display:flex;justify-content:space-between;gap:8px}.deal-top strong{font-size:13px}.deal-top span{font-size:11px;font-weight:700;white-space:nowrap}.deal-card p{font-size:11px;color:var(--muted);margin:6px 0 4px}.deal-card>small{color:var(--muted);font-size:10px}.deal-tags{display:flex;gap:4px;flex-wrap:wrap;margin:10px 0}.deal-tags span{font-size:9px;font-weight:700;padding:3px 6px;border-radius:6px}.contact{border-top:1px solid var(--line);padding-top:9px;margin-top:8px;display:flex;justify-content:space-between;color:var(--muted);font-size:9px}.contact b{font-weight:700}.contact.overdue{color:#e04444}.empty-col{border:1px dashed var(--line);border-radius:10px;padding:18px 8px;text-align:center;color:var(--muted);font-size:10px}.drawer-wrap,.modal-wrap{position:fixed;inset:0;z-index:80}.drawer-backdrop,.modal-backdrop{position:absolute;inset:0;border:0;background:#1115;backdrop-filter:blur(2px)}.drawer{position:absolute;right:0;top:0;bottom:0;width:min(610px,100%);background:var(--panel);box-shadow:-20px 0 80px #0002;display:flex;flex-direction:column}.drawer-head{padding:24px 25px 17px;display:flex;justify-conten