t:space-between;align-items:flex-start;border-bottom:1px solid var(--line)}.title-input{display:block;border:0;background:transparent;color:var(--ink);font-size:24px;font-weight:800;letter-spacing:-.03em;padding:4px 0;width:440px;outline:none}.drawer-tabs{height:50px;border-bottom:1px solid var(--line);display:flex;padding:0 25px;gap:24px}.drawer-tabs button{border:0;background:transparent;color:var(--muted);font-weight:700;font-size:12px;position:relative}.drawer-tabs button.active{color:var(--ink)}.drawer-tabs button.active:after{content:"";position:absolute;left:0;right:0;bottom:-1px;height:2px;background:var(--accent)}.drawer-tabs span{background:var(--panel2);padding:2px 5px;border-radius:5px}.drawer-body{padding:24px 25px 50px;overflow:auto}.drawer-body section{border-bottom:1px solid var(--line);padding-bottom:22px;margin-bottom:22px}.drawer-body h3{font-size:13px;margin:0 0 13px}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:13px}.form-grid label,.modal-form label{display:grid;gap:6px;font-size:10px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.06em}.form-grid input,.form-grid select,.modal-form input,.modal-form select,.inline-form input,textarea{height:40px;border:1px solid var(--line);background:var(--panel2);color:var(--ink);border-radius:10px;padding:0 11px;outline:0;font-size:12px;text-transform:none;letter-spacing:normal}.form-grid input:focus,.form-grid select:focus,.inline-form input:focus,textarea:focus{border-color:#84cc16}.form-grid input[type=checkbox]{width:22px;height:22px}.tag-picker{display:flex;flex-wrap:wrap;gap:7px}.tag-choice{border:1px solid var(--line);background:transparent;color:var(--muted);border-radius:9px;padding:7px 9px;display:flex;align-items:center;gap:6px;font-size:11px}.tag-choice i{width:7px;height:7px;border-radius:50%}.tag-choice.selected{border-color:var(--ink);color:var(--ink)}.inline-form{display:flex;gap:7px}.inline-form input{flex:1}.mini-task{display:flex;align-items:center;gap:8px;margin-top:8px;font-size:11px}.mini-task svg{width:15px;color:#7cad2f}.mini-task small{margin-left:auto;color:var(--muted)}.danger-link{border:0;background:transparent;color:#e04444;display:flex;align-items:center;gap:8px;font-size:12px}.danger-link svg{width:16px}textarea{min-height:90px;width:100%;padding:10px;resize:vertical;margin-bottom:8px}.timeline{display:grid;grid-template-columns:auto 1fr;gap:11px;margin:16px 0}.timeline>span{width:30px;height:30px;border-radius:50%;background:var(--panel2);display:grid;place-items:center}.timeline svg{width:13px}.timeline div{display:grid;gap:3px}.timeline strong{font-size:11px}.timeline p{font-size:12px;margin:3px 0;color:var(--muted)}.timeline small{font-size:9px;color:var(--muted)}.modal{position:relative;width:min(480px,calc(100% - 28px));margin:10vh auto;background:var(--panel);border-radius:18px;box-shadow:0 25px 80px #0003;padding:22px;color:var(--ink)}.modal-head{display:flex;align-items:center;justify-content:space-between}.modal-head h2{margin:0;font-size:19px}.modal-form{display:grid;gap:14px;margin-top:20px}.modal-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:8px}.task-tabs{margin-bottom:15px}.task-list{padding:4px 20px}.task-row{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:14px;padding:17px 0;border-bottom:1px solid var(--line)}.task-row:last-child{border:0}.check{border:0;background:none;color:var(--muted);padding:0}.check svg{width:21px}.check.done{color:#84cc16}.task-row strong{font-size:13px}.task-row p{margin:4px 0 0;font-size:11px;color:var(--muted)}.due{font-size:11px;display:flex;align-items:center;gap:6px;color:var(--muted)}.due svg{width:14px}.due.overdue{color:#e04444}.empty-state{text-align:center;padding:60px 20px;color:var(--muted)}.empty-state>svg{width:38px}.empty-state h3{color:var(--ink);margin-bottom:5px}.empty-state p{font-size:12px}.metrics.analytics{grid-template-columns:repeat(5,1fr)}.metric.compact{display:grid;gap:6px}.analytics-grid{display:grid;grid-template-columns:1.5fr 1fr;gap:18px}.chart-panel{min-width:0}.recharts-cartesian-grid line{stroke:var(--line)}.recharts-text{fill:var(--muted);font-size:10px}.conversion>strong{font-size:30px;display:block;margin:20px 0 5px}.conversion>p{font-size:12px;color:var(--muted)}.conversion-ring{--value:90deg;width:156px;height:156px;border-radius:50%;background:conic-gradient(var(--accent) var(--value),var(--panel2) 0);display:grid;place-items:center;margin:25px auto 0;position:relative}.conversion-ring:before{content:"";position:absolute;inset:14px;border-radius:50%;background:var(--panel)}.conversion-ring span{position:relative;font-size:25px;font-weight:800;text-align:center}.conversion-ring small{display:block;font-size:9px;color:var(--muted);font-weight:600}.settings-grid{display:grid;grid-template-columns:1.35fr 1fr;gap:18px}.settings-wide{grid-row:span 2}.pipeline-setting{border-bottom:1px solid var(--line);padding-bottom:18px;margin-bottom:18px}.pipeline-name{display:flex;align-items:center;justify-content:space-between;font-size:13px;margin-bottom:10px}.stage-settings{display:grid;gap:6px}.stage-settings label{display:flex;align-items:center;gap:7px}.stage-settings input{border:0;background:var(--panel2);color:var(--ink);border-radius:8px;padding:8px 10px;width:100%;font-size:11px}.settings-list{display:grid;margin-bottom:15px}.settings-list>div{display:flex;align-items:center;gap:9px;border-bottom:1px solid var(--line);padding:10px 0;font-size:12px}.settings-list .icon{margin-left:auto}.settings-list small{margin-left:auto;color:var(--muted)}.login{min-height:100vh;background:#f4f5f1;display:grid;grid-template-columns:1fr 1fr}.login-panel{padding:8vh 8vw;display:flex;flex-direction:column;align-items:flex-start;justify-content:center}.login-panel>.eyebrow{margin-top:28px}.login-panel h1{font-size:clamp(38px,4vw,64px);line-height:1.03;letter-spacing:-.055em;margin:15px 0 18px;max-width:680px}.login-panel>p{color:#73776f;line-height:1.7;max-width:520px;font-size:15px}.demo-user{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:12px;border:1px solid #dadcd5;background:#fff;padding:14px;border-radius:14px;width:min(420px,100%);margin:30px 0 12px}.demo-user div{display:grid}.demo-user strong{font-size:13px}.demo-user small{font-size:11px;color:#777}.demo-user svg{width:18px;color:#777}.login-button{width:min(420px,100%);height:49px}.login-panel>small{color:#888;font-size:10px;width:min(420px,100%);text-align:center;margin-top:12px}.login-art{background:#1b1c19;position:relative;overflow:hidden;display:grid;place-items:center}.login-art:before{content:"";position:absolute;width:500px;height:500px;border-radius:50%;background:#a3e635;filter:blur(120px);opacity:.18}.art-card{width:330px;background:#fff;padding:25px;border-radius:22px;box-shadow:0 30px 100px #0007;transform:rotate(-4deg);position:relative;z-index:2}.art-card>span{font-size:10px;text-transform:uppercase;letter-spacing:.1em;color:#777}.art-card strong{font-size:22px;display:block;margin:20px 0 3px}.art-card p{color:#777;font-size:13px}.art-card div{border-top:1px solid #eee;padding-top:14px;margin-top:30px;font-size:11px;display:flex;align-items:center;gap:8px}.art-card i{width:8px;height:8px;border-radius:50%;background:#a3e635}.art-orbit{position:absolute;border:1px solid #ffffff14;border-radius:50%}.art-orbit.one{width:600px;height:600px}.art-orbit.two{width:850px;height:850px}
@media(max-width:900px){.sidebar{transform:translateX(-100%);transition:.25s}.sidebar.open{transform:none}.main{margin:0;width:100%}.menu,.mobile-close{display:grid}.mobile-close{margin-left:auto}.scrim{position:fixed;inset:0;border:0;background:#0007;z-index:35}.content{padding:22px 16px}.topbar{padding:0 15px}.top-avatar{display:grid}.metrics,.metrics.analytics{grid-template-columns:repeat(2,1fr)}.dashboard-grid,.analytics-grid,.settings-grid{grid-template-columns:1fr}.settings-wide{grid-row:auto}.page-head{align-items:flex-start}.login{grid-template-columns:1fr}.login-art{display:none}.login-panel{padding:40px 24px;min-height:100vh}.deals-toolbar{align-items:flex-start;flex-direction:column}.pipeline-tabs{max-width:100%;overflow:auto}}
@media(max-width:600px){.topbar{height:64px}.search{width:auto;flex:1}.page-head{display:grid}.page-head h1{font-size:26px}.head-actions{display:grid;grid-template-columns:1fr 1fr;width:100%}.head-actions .button:last-child{grid-column:1/-1}.metrics,.metrics.analytics{grid-template-columns:1fr 1fr}.metric