{padding:13px}.metric>span{display:none}.metric strong{font-size:20px}.form-grid{grid-template-columns:1fr}.title-input{width:calc(100vw - 100px);font-size:20px}.drawer-head,.drawer-body{padding-left:17px;padding-right:17px}.task-tabs{width:100%;overflow:auto}.task-tabs button{white-space:nowrap}.task-row{grid-template-columns:auto 1fr}.due{grid-column:2}.art-card{width:280px}.login-panel h1{font-size:38px}.panel{padding:17px}}
